# Network Configuration
# Get your RPC URLs from:
# - Infura: https://www.infura.io
# - Alchemy: https://www.alchemy.com
# - QuickNode: https://www.quicknode.com

# Private key (DO NOT expose in production!)
# PRIVATE_KEY=your_private_key_here

# Goerli Testnet (Ethereum)
GOERLI_RPC_URL=https://goerli.infura.io/v3/

# Sepolia Testnet (Ethereum)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/

# Mumbai Testnet (Polygon)
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com/

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com/

# Ethereum Mainnet (Production)
# ETH_RPC_URL=https://mainnet.infura.io/v3/

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Pinata IPFS Configuration
# Get your keys from: https://www.pinata.cloud
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here